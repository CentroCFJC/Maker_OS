# Copy to .env and set a real secret before deploying.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Session signing key (REQUIRED in production)
MAKEROS_SECRET_KEY=change-me-to-a-long-random-string

# Optional overrides (defaults shown)
# MAKEROS_CONTENT_DIR=./content
# MAKEROS_PRIVATE_DIR=./private
# MAKEROS_DB_PATH=./data/makeros.db

# External base URL: set on the lab server so generated links (e.g. the
# ICS feed) show the address people actually use, not the internal one.
# Examples: http://192.168.1.50:8080  |  https://makeros.my-tailnet.ts.net
# MAKEROS_BASE_URL=

# Set to 1 only when serving over HTTPS (e.g. behind `tailscale serve`
# or Caddy with TLS). Session cookies then carry the Secure flag.
# On plain HTTP (bare IP) leave unset or cookies stop working.
# MAKEROS_COOKIE_SECURE=0

# Google Calendar two-way sync (docs/GCALENDAR.md). Credentials can be
# pasted in the admin panel (Integraciones) instead of here; these env
# vars are an optional fallback. Redirect URI defaults to
# {MAKEROS_BASE_URL}/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
